{
  "name": "enlace-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Enlace: a private pedometer RPG that runs in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
